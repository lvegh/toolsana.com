# ToolzyHub API Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api
API_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT Configuration (separate secret for admin panel)
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8787
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SLOW_DOWN_DELAY_AFTER=50
SLOW_DOWN_DELAY_MS=500

# Redis Configuration (Optional - for advanced features)
# Uncomment if using Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_URL=redis://localhost:6379

# Email Configuration (for contact form, API key delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=ToolzyHub
SMTP_FROM_EMAIL=noreply@toolzyhub.com

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_AI_FILE_SIZE=52428800

# Admin Panel Configuration
ADMIN_FRONTEND_URL=http://localhost:3002

# Image Processing Configuration
SHARP_CACHE=true

# API Secret Token (for worker-to-API communication)
API_SECRET_TOKEN=your-api-secret-token

# Cloudflare Turnstile - contact form captcha (verified server-side).
# Required: routes/contact.js fails closed without it.
# Set TURNSTILE_DISABLED=true to bypass locally when you have no secret.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Local development only: skip API token validation. Leave unset/false
# anywhere real. Ignored when NODE_ENV=production.
DISABLE_API_AUTH=false

# Brevo transactional/marketing API key - newsletter signup (routes/subscribe.js).
BREVO_API_KEY=your-brevo-api-key

# Shared secret proving a request came through the Cloudflare Worker.
# Must match the Worker's EDGE_SECRET. Unset = accept direct requests (dev only).
EDGE_SECRET=your-edge-secret

# Required in production behind the Worker: forwarded requests carry no Origin
# header, and production CORS rejects origin-less requests unless this is set.
ALLOW_NO_ORIGIN=true

# Set to true ONLY when this API runs with no edge proxy in front of it
# (VPS-only deployment, or an emergency migration off Cloudflare). It turns off
# edge verification and satisfies the production config check that otherwise
# requires EDGE_SECRET. Restrict access at the firewall when using this.
ALLOW_DIRECT_ORIGIN=false
